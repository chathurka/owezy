    "version": "0.2.0",
    "configurations": [
        {
            "name": "mobile:dev",
            "cwd": "apps/mobile",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=APP_FLAVOR=dev"
            ]
        },
        {
            "name": "mobile:qa",
            "cwd": "apps/mobile",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=APP_FLAVOR=qa"
            ]
        },
        {
            "name": "mobile:prod",
            "cwd": "apps/mobile",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=APP_FLAVOR=prod"
            ]
        },
        {
            "name": "mobile:dev (profile)",
            "cwd": "apps/mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=APP_FLAVOR=dev"
            ]
        },
        {
            "name": "mobile:prod (release)",
            "cwd": "apps/mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=APP_FLAVOR=prod"
            ]
        }
    ]
}
