{
  "name": "owezy",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/api",
    "apps/admin-web",
    "apps/user-web",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @owezy/api dev",
    "dev:api:qa": "pnpm --filter @owezy/api dev:qa",
    "dev:api:prod": "pnpm --filter @owezy/api dev:prod",
    "dev:admin": "pnpm --filter @owezy/admin-web dev",
    "dev:admin:qa": "pnpm --filter @owezy/admin-web dev:qa",
    "dev:admin:prod": "pnpm --filter @owezy/admin-web dev:prod",
    "dev:user": "pnpm --filter @owezy/user-web dev",
    "dev:user:qa": "pnpm --filter @owezy/user-web dev:qa",
    "dev:user:prod": "pnpm --filter @owezy/user-web dev:prod",
    "dev:mobile": "cd apps/mobile && flutter run --dart-define=APP_FLAVOR=dev",
    "dev:mobile:qa": "cd apps/mobile && flutter run --dart-define=APP_FLAVOR=qa",
    "dev:mobile:prod": "cd apps/mobile && flutter run --dart-define=APP_FLAVOR=prod",
    "build:api": "pnpm --filter @owezy/api build",
    "build:admin": "pnpm --filter @owezy/admin-web build",
    "build:user": "pnpm --filter @owezy/user-web build",
    "build:mobile": "cd apps/mobile && flutter build apk --dart-define=APP_FLAVOR=dev",
    "build:mobile:qa": "cd apps/mobile && flutter build apk --dart-define=APP_FLAVOR=qa",
    "build:mobile:prod": "cd apps/mobile && flutter build apk --dart-define=APP_FLAVOR=prod",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @owezy/api migration:run",
    "db:migration:generate": "pnpm --filter @owezy/api migration:generate"
  }
}
