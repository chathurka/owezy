# API — Production
APP_ENV=prod
NODE_ENV=production
PORT=3000

DB_HOST=replace_with_prod_db_host
DB_PORT=5432
DB_USER=replace_with_prod_db_user
DB_PASS=replace_with_prod_db_pass
DB_NAME=owezy_prod

JWT_ACCESS_SECRET=replace_with_strong_secret_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_prod
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_placeholder_prod
EMAIL_FROM=noreply@owezy.app

USER_WEB_URL=https://owezy.app

FEATURE_PREMIUM_TIER=false
FEATURE_AI_EXPENSE_ENTRY=false
FEATURE_RECEIPT_OCR=false

CURRENCY_PROVIDER=open_exchange_rates
CURRENCY_CACHE_TTL_SECS=3600

# Comma-separated Apple Services ID / bundle IDs (JWT audiences)
APPLE_CLIENT_IDS=
# Comma-separated Google OAuth client IDs (web/iOS/Android audiences)
GOOGLE_CLIENT_IDS=
