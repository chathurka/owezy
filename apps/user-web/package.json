{
  "name": "@owezy/user-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "use:dev": "cp env/.env.dev .env.local",
    "use:qa": "cp env/.env.qa .env.local",
    "use:prod": "cp env/.env.prod .env.local",
    "dev": "pnpm use:dev && next dev -p 3002",
    "dev:qa": "pnpm use:qa && next dev -p 3002",
    "dev:prod": "pnpm use:prod && next dev -p 3002",
    "build": "pnpm use:dev && next build",
    "build:qa": "pnpm use:qa && next build",
    "build:prod": "pnpm use:prod && next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@owezy/design-system": "workspace:*",
    "jose": "^5.2.0",
    "lucide-react": "0.460.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5"
  }
}
